# Supabase PostgreSQL 연결에 필요한 환경변수 예시입니다.
SPRING_PROFILES_ACTIVE=supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# Direct connection이 가능한 환경에서는 아래 형식을 대신 사용합니다.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres

# 카카오 소셜 로그인을 위한 환경 변수입니다.
KAKAO_NATIVE_APP_KEY=<kakao-native-app-key>
KAKAO_ADMIN_KEY=<kakao-admin-key>

# 애플 소셜 로그인을 위한 환경 변수입니다.
APPLE_CLIENT_ID=com.dewby.Nearby
APPLE_TEAM_ID=2YTVA7GW5S
APPLE_KEY_ID=NZG42786TR
APPLE_PRIVATE_KEY_BASE64=<base64-encoded-apple-private-key>
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# SMS 인증 코드 전송을 위한 SOLAPI 환경 변수입니다.
SOLAPI_API_KEY
SOLAPI_API_SECRET
SOLAPI_FROM_NUMBER

# Google Place API 환경 변수입니다.
GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_SEARCH_TIMEOUT_MS=5000

# Redis 환경 변수입니다.
SPRING_DATA_REDIS_HOST
SPRING_DATA_REDIS_PORT
SPRING_DATA_REDIS_SSL_ENABLED

# Sentry 오류 모니터링 환경 변수입니다.
SENTRY_DSN
SENTRY_ENVIRONMENT=production

# Gmail SMTP 신고 메일 발송을 위한 환경 변수입니다.
SMTP_USERNAME
SMTP_APP_PASSWORD
REPORT_MAIL_TO=nearbytravel11@gmail.com
